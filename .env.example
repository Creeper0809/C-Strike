# C-STRIKE 2026 운영 포털 — 환경 변수 설정
# 이 파일을 .env로 복사한 뒤 값을 채워 사용하세요.

# 서버 IP (필수)
# nginx SSL 자가서명 인증서 SAN(Subject Alternative Name)에 들어가는 IP.
# 다른 서버에 배포할 때는 자기 서버의 실제 IP로 반드시 변경하세요.
#
# IP 변경 시 인증서 재발급 절차 (멱등 체크 우회):
#   1) SERVER_IP=새IP 로 변경
#   2) rm -f infra/nginx/ssl/{ops-portal,scoreboard}.{crt,key}
#   3) cd infra && docker compose up -d --build
#   → 새 IP가 SAN에 들어간 자가서명 인증서 자동 재발급됨
SERVER_IP=192.168.100.129

# ============================================================
# SSL 인증서 운영 모드 (기본: 자가서명. 납품 환경에 맞게 교체 가능)
# ============================================================
# [기본] 자가서명 — 현재 적용 상태
#   - 별도 작업 없음. docker compose up -d --build 한 줄로 4개 인증서 자동 발급
#     (scoreboard.{crt,key}, ops-portal.{crt,key})
#   - 브라우저에 "주의 요함" 표시 (자가서명의 본질). 통신/데이터는 정상 암호화
#   - 운영자/심사위원에게 "고급 → 안전하지 않은 사이트로 이동" 1회 클릭 안내 필요
#
# [무경고 모드] 공용 IP에 무료 인증서 발급 (납품처가 공용 IP 보유 시 권장)
#   - 도메인 없이 공용 IP로 발급 가능한 무료 CA 사용
#   - 옵션 1) Let's Encrypt — 2025년 IP 인증서 GA. Short-lived 6일 (자동 갱신 필수)
#       acme.sh --issue --standalone -d <공용IP> --server letsencrypt
#   - 옵션 2) ZeroSSL — IP 인증서 90일 (무료 가입 후 발급, 갱신 부담 적음)
#       acme.sh --issue --standalone -d <공용IP> --server zerossl
#       또는 https://zerossl.com 웹 UI에서 IP 입력 → HTTP File Validation
#   - 발급된 .crt/.key를 다음 경로에 배치:
#       infra/nginx/ssl/ops-portal.crt, ops-portal.key
#       infra/nginx/ssl/scoreboard.crt, scoreboard.key
#   - docker compose restart nginx
#     (자가서명 generate-certs.sh의 멱등 체크가 새 인증서 감지 후 skip)
#   - 운영 갱신: acme.sh가 cron으로 자동 갱신, nginx reload만 필요
# ============================================================

# ============================================================
# [참고용] DATABASE_URL / REDIS_URL / JWT_ALGORITHM / JWT_EXPIRE_MINUTES / ALLOWED_ORIGINS
# ------------------------------------------------------------
# 현재 운영 구성은 docker-compose의 environment: 블록에서
# POSTGRES_PASSWORD / REDIS_PASSWORD 만으로 URL을 자동 조립하며,
# JWT 알고리즘/만료/CORS는 컨테이너 기본값을 사용합니다.
# 따라서 아래 값들은 .env에 세팅해도 compose 구성에서는 무시됩니다.
# 로컬 개발 시 compose 밖에서 ops-backend를 직접 실행할 때만 참고하세요.
# ============================================================

# 데이터베이스
POSTGRES_PASSWORD=변경필수_강력한비밀번호
# [참고용] DATABASE_URL=postgresql+asyncpg://ops_svc:${POSTGRES_PASSWORD}@postgres:5432/ops_db

# Redis
REDIS_PASSWORD=변경필수_강력한비밀번호
# [참고용] REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# JWT 인증 (반드시 변경!)
JWT_SECRET_KEY=변경필수_32자이상_랜덤문자열
# [참고용] JWT_ALGORITHM=HS256
# [참고용] JWT_EXPIRE_MINUTES=480

# 초기 관리자 계정 (최초 실행 후 변경 권장)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=변경필수_강력한비밀번호

# [참고용] CORS 허용 오리진 (Nginx 프록시 뒤에서는 불필요)
# ALLOWED_ORIGINS=http://localhost:3000

# 외부 시스템 URL — Docker 내부 서비스명 기준
SCORING_URL=http://scoring-engine:8460
SCOREBOARD_URL=http://scoreboard:8000
# Phase 15 외부 시스템 — 실제 배포 시 담당자에게 URL 받아서 설정
VANGUARD_URL=http://vanguard:8401
CONTAINER_MANAGER_URL=http://container-manager:8403
DISCORD_BOT_URL=http://discord-bot:5000

# C가드 연동 (코드 수령 후 실제 주소로 변경)
CGUARD_SERVER_URL=http://cguard-server:8500
CGUARD_DASHBOARD_URL=http://cguard-dashboard:8501

# ============================================================
# Phase 11: deploy-service + MinIO
# ============================================================
# INTERNAL_API_KEY: ops-backend ↔ deploy-service 내부 호출용 공유 키
INTERNAL_API_KEY=변경필수_내부_API_키
# MINIO: 취약점 팩 아카이브 저장소 (S3 호환)
MINIO_ACCESS_KEY=cstrike
MINIO_SECRET_KEY=변경필수_MinIO_시크릿
# DOCKER_GID: 호스트에서 `getent group docker | cut -d: -f3` 로 조회 (Ubuntu 기본 999)
DOCKER_GID=999

# ============================================================
# Phase 13: 채점 엔진 (SCORING_ 접두사 — ops-backend의 SCORING_URL과 무관)
# ============================================================
SCORING_LOG_LEVEL=INFO
SCORING_SSH_KEY_PATH=/app/keys/scoring_key
SCORING_MAX_CONCURRENT_SSH=20
SCORING_SLA_TIMEOUT_SECONDS=10
SCORING_FLAG_LIFETIME_ROUNDS=2

# SSH 비밀번호 암호화 키 (Fernet — ops-backend + scoring-engine 공용)
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SSH_ENCRYPTION_KEY=변경필수_Fernet키
SCORING_SSH_ENCRYPTION_KEY=변경필수_SSH_ENCRYPTION_KEY와_동일값

# ============================================================
# Discord 봇 외주 (2026-04-17 OPS_BOT 통합)
# ============================================================
# 운영자가 본인 Discord 서버에 봇 설치 후 아래 값을 교체하세요.
#   - DISCORD_TOKEN: Discord Developer Portal(https://discord.com/developers) 에서 발급
#   - DISCORD_GUILD_ID: Discord 서버 우클릭 → ID 복사 (개발자 모드 활성화 필요)
#   - DISCORD_AUDIT_LOG_CHANNEL_ID: 감사 로그 전송할 텍스트 채널 ID
#   - DISCORD_TICKET_CATEGORY_ID: 티켓 채널이 생성될 카테고리 ID
#   - BOT_API_KEY: 생성 예시 → openssl rand -base64 48
DISCORD_TOKEN=변경필수_Discord_봇_토큰
DISCORD_GUILD_ID=변경필수_Guild_ID
DISCORD_AUDIT_LOG_CHANNEL_ID=변경필수_감사로그_채널_ID
DISCORD_TICKET_CATEGORY_ID=변경필수_티켓_카테고리_ID
BOT_API_KEY=변경필수_봇_API_키
# 활성 대회 ID (비워두면 운영 중 자동 설정됨)
BOT_COMPETITION_ID=
# Discord 역할명 (기본값 권장 — 수동으로 역할 생성 시 이 이름과 일치시킬 것)
DISCORD_OPERATOR_ROLE_NAME=운영진
DISCORD_AUTHENTICATED_ROLE_NAME=C-GUARD 인증
DISCORD_UNAUTHENTICATED_ROLE_NAME=C-GUARD 제한

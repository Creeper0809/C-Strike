DATABASE_URL=postgresql+asyncpg://ops_svc:ops_password@localhost:5432/ops_db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234
SCORING_URL=http://scoring-engine:8460
SCOREBOARD_URL=http://scoreboard:8000
VANGUARD_URL=http://vanguard:8401
CONTAINER_MANAGER_URL=http://container-manager:8403
DISCORD_BOT_URL=http://discord-bot:8405

# C가드 연동 (코드 수령 후 실제 주소로 변경)
CGUARD_SERVER_URL=http://cguard-server:8500
CGUARD_DASHBOARD_URL=http://cguard-dashboard:8501

# 팀 삭제 시 라우터 VPN/iptables 자동 정리 (선택)
NETWORK_TEAM_DELETE_ENABLED=false
NETWORK_TEAM_DELETE_HOST=
NETWORK_TEAM_DELETE_PORT=22
NETWORK_TEAM_DELETE_USER=
NETWORK_TEAM_DELETE_PASSWORD=
NETWORK_TEAM_DELETE_ROOT=/home/user/network
NETWORK_TEAM_DELETE_USE_SUDO=true
NETWORK_TEAM_DELETE_TIMEOUT_SECONDS=120
NETWORK_TEAM_DELETE_EXECUTE_USERS=true
NETWORK_TEAM_DELETE_PURGE_USERS=false
NETWORK_TEAM_DELETE_RELEASE_IP=false

# 팀 생성 시 라우터 VPN/iptables 자동 생성 (선택)
NETWORK_TEAM_PROVISION_ENABLED=false
NETWORK_TEAM_PROVISION_HOST=
NETWORK_TEAM_PROVISION_PORT=22
NETWORK_TEAM_PROVISION_USER=
NETWORK_TEAM_PROVISION_PASSWORD=
NETWORK_TEAM_PROVISION_ROOT=/home/user/network
NETWORK_TEAM_PROVISION_USE_SUDO=true
NETWORK_TEAM_PROVISION_TIMEOUT_SECONDS=120
NETWORK_TEAM_PROVISION_EXECUTE_USERS=true
NETWORK_TEAM_PROVISION_REUSE_RETIRED=true
NETWORK_TEAM_PROVISION_USERS_PER_TEAM=0

# 팀 슬롯 풀은 기본적으로 라우터 inventory/team-slots.csv 에서 읽음
TEAM_SLOT_INVENTORY_FILENAME=team-slots.csv
TEAM_SLOT_DEFAULT_SSH_PORT=22
TEAM_SLOT_DEFAULT_SSH_USER=
TEAM_SLOT_DEFAULT_SSH_PASSWORD=
